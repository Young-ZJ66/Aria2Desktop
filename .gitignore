# 依赖
node_modules

# 构建产物
dist
release
*.tsbuildinfo

# E2E 产物（截图 / 日志 / 隔离 userData）
test-results

# 评审报告 / 本地文档（工作产物，不入库）
deliverables
docs/*
# 面向用户/维护者的正式文档需要随仓库发布，链接才可用
!docs/automation-cli-webhook.md
!docs/code-signing.md
!docs/code-signing-policy.md
!docs/plugin-development.md
!docs/privacy.md

# 运行时数据
data

# 引擎二进制：按 平台/架构 随仓库分发（resources/aria2/<platform>/<arch>/），
# 旧布局的临时副本（构建期复制产物）不再入库
resources/aria2c.exe

# 环境变量
.env
.env.*

# 扩展签名密钥（决定扩展 ID，泄露=任何人都能签发同 ID 的扩展；CI 用 GitHub Secret 注入）
.crx/
*.pem
# 例外：差量更新测试用的本地一次性证书（只服务于 127.0.0.1 的测试 HTTPS 服务，无任何真实密钥）
!electron/services/__fixtures__/delta-test-*.pem

# 日志
*.log

# AI 工具 / 编辑器配置
.codebuddy
.cursor
.vscode
.idea
.trae
.trae-html-share-packages
.augment
.sanshu-memory
.workbuddy
.mimosa

# 系统文件
.DS_Store
Thumbs.db
