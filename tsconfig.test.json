{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "noEmit": true,
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "electron/**/*.test.ts",
    "src/**/*.test.ts",
    "vitest.config.mts",
    "src/types/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release"
  ]
}
