{
  "name": "aria2-desktop",
  "version": "1.3.2",
  "description": "集成 Aria2 引擎的现代化桌面下载管理器",
  "main": "dist/electron/electron/main.js",
  "author": "Young-ZJ66",
  "license": "MIT",
  "homepage": "https://github.com/Young-ZJ66/Aria2Desktop",
  "scripts": {
    "dev": "concurrently --kill-others --kill-others-on-fail \"npm run dev:vue\" \"npm run dev:electron\"",
    "dev:vue": "vite",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "build": "npm run build:vue && npm run build:electron && node scripts/verify-resources.mjs",
    "build:vue": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win64": "npm run dist:win64:prepare && npm run dist:win64:nsis && npm run dist:win64:portable",
    "dist:win64:prepare": "npm run build && node scripts/verify-engine.mjs win32 x64",
    "dist:win64:nsis": "electron-builder --win --x64 --config.win.target=nsis --config.win.artifactName=\"Aria2Desktop-${version}-x64-Setup.${ext}\"",
    "dist:win64:portable": "electron-builder --win --x64 --config.win.target=zip --config.win.artifactName=\"Aria2Desktop-${version}-x64-portable.${ext}\"",
    "dist:win32": "npm run dist:win32:prepare && npm run dist:win32:nsis && npm run dist:win32:portable",
    "dist:win32:prepare": "npm run build && node scripts/verify-engine.mjs win32 ia32",
    "dist:win32:nsis": "electron-builder --win --ia32 --config.win.target=nsis --config.win.artifactName=\"Aria2Desktop-${version}-x86-Setup.${ext}\"",
    "dist:win32:portable": "electron-builder --win --ia32 --config.win.target=zip --config.win.artifactName=\"Aria2Desktop-${version}-x86-portable.${ext}\"",
    "dist:win-all": "npm run dist:win64 && npm run dist:win32",
    "dist:mac": "npm run build && node scripts/verify-engine.mjs darwin x64 && node scripts/verify-engine.mjs darwin arm64 && electron-builder --mac",
    "dist:linux": "npm run build && node scripts/verify-engine.mjs linux x64 && electron-builder --linux --x64",
    "dist:linux:arm64": "npm run build && node scripts/verify-engine.mjs linux arm64 && electron-builder --linux --arm64",
    "pack:extension": "node scripts/pack-extension-crx.mjs",
    "pack:extension-zip": "node scripts/pack-extension-zip.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "verify:extension-api": "node scripts/verify-extension-api.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:e2e": "node scripts/e2e/run-e2e.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json && vue-tsc -p tsconfig.json --noEmit",
    "typecheck:vue": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.2.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "axios": "^1.19.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.10",
    "echarts": "^6.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "file-saver": "^2.0.5",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.1",
    "vue": "^3.5.13",
    "vue-echarts": "^8.1.0",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.2.5",
    "vue-tsc": "^3.3.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aria2desktop.app",
    "productName": "Aria2Desktop",
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "Young-ZJ66",
        "repo": "Aria2Desktop"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US",
      "ja",
      "ko",
      "de",
      "fr"
    ],
    "files": [
      "dist/**/*",
      "!dist/vue/**/*.map",
      "node_modules/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "dist/vue/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "plugins/download-notifier",
        "to": "plugins/download-notifier"
      }
    ],
    "protocols": [
      {
        "name": "Magnet",
        "schemes": [
          "magnet"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent",
        "description": "BitTorrent metainfo file",
        "role": "Editor"
      },
      {
        "ext": "metalink",
        "name": "Metalink",
        "description": "Metalink download description",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/Icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Aria2Desktop-${version}-${arch}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "extraResources": [
        {
          "from": "resources/aria2/win32/${arch}/aria2c.exe",
          "to": "aria2c.exe"
        },
        {
          "from": "build/Icon.ico",
          "to": "Icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/Icon.ico",
      "uninstallerIcon": "build/Icon.ico",
      "installerHeaderIcon": "build/Icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aria2 Desktop",
      "perMachine": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "artifactName": "Aria2Desktop-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "resources/aria2/darwin/${arch}/aria2c",
          "to": "aria2c"
        },
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 230,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 230,
          "type": "file"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Young-ZJ66 <youngzj66@users.noreply.github.com>",
      "icon": "build/icon.png",
      "artifactName": "Aria2Desktop-${version}-${arch}.${ext}",
      "mimeTypes": [
        "x-scheme-handler/magnet",
        "application/x-bittorrent",
        "application/x-metallink"
      ],
      "extraResources": [
        {
          "from": "resources/aria2/linux/${arch}/aria2c",
          "to": "aria2c"
        },
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "vue-demi@0.14.10": true
  }
}
