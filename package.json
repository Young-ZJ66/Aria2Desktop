{
  "name": "aria2-desktop",
  "version": "1.0.0",
  "description": "集成 Aria2 引擎的现代化桌面下载管理器",
  "main": "dist/electron/electron/main.js",
  "author": "Your Name",
  "license": "MIT",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently --kill-others --kill-others-on-fail \"npm run dev:vue\" \"npm run dev:electron\"",
    "dev:vue": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "npm run build:vue && npm run build:electron",
    "build:vue": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "electron-store": "^8.2.0",
    "naive-ui": "^2.44.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "axios": "^1.19.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.10",
    "echarts": "^6.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vue": "^3.5.13",
    "vue-echarts": "^8.1.0",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.2.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aria2desktop.app",
    "productName": "Aria2Desktop",
    "icon": "build/Icon.ico",
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "!dist/vue/**/*.map",
      "node_modules/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "dist/vue/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/aria2c.exe",
        "to": "aria2c.exe"
      },
      {
        "from": "build/Icon.ico",
        "to": "Icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/Icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Aria2Desktop-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": "Aria2 Desktop Team"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/Icon.ico",
      "uninstallerIcon": "build/Icon.ico",
      "installerHeaderIcon": "build/Icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aria2 Desktop",
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "vue-demi@0.14.10": true
  }
}
